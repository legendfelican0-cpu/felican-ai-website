# Public scheduling event used by the React booking route.
VITE_CALENDLY_URL=https://calendly.com/your-account/your-event

# Contact form + assistant email handoff (Resend).
# Without RESEND_API_KEY the /api/contact endpoint returns 503 and the form
# tells visitors to email directly — the rest of the site is unaffected.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered.
CONTACT_TO=ai@felican.ai
# Must be an address on a domain verified in the Resend dashboard (felican.ai is verified).
# Do NOT wrap this in quotes: production loads it via `docker --env-file`, which takes the
# line literally, so quotes would end up inside the value. Note this means the file is not
# safe to `source` in bash — use `node --env-file` or docker.
CONTACT_FROM=Felican AI Website <website@felican.ai>

# Starter Pack checkout (Stripe). Without STRIPE_SECRET_KEY the /api/checkout
# endpoint returns 503 and the checkout page tells the buyer to email us — the
# rest of the site is unaffected. Use sk_test_... until you are ready for real money.
STRIPE_SECRET_KEY=<set>

# Signing secret for POST /api/stripe-webhook. This is different from the API
# key above; copy the whsec_... value from the webhook endpoint in Stripe.
STRIPE_WEBHOOK_SECRET=<set>

# Durable order records. Production deploys mount a private writable directory
# here automatically. Set this explicitly for any other read-only/container host.
ORDER_STORE_PATH=./data/starter-pack-orders.json

# Optional. Overrides the origin used to build Stripe success/cancel URLs and the
# setup link in the welcome email. Leave unset to derive it from the request host.
SITE_ORIGIN=<set>
