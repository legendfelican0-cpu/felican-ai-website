{
  "name": "felican-ai-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "test:booking": "node scripts/verify-booking.mjs",
    "load:staging": "node scripts/load-test.mjs https://felican.dev/",
    "build:images": "node scripts/optimize-images.mjs",
    "build:content": "node scripts/build-content.mjs",
    "sync:schema": "node scripts/sync-schema.mjs",
    "fix:images": "node scripts/fix-images.mjs",
    "seo": "npm run build:images && npm run build:content && npm run patch:pages && npm run sync:schema && npm run fix:images",
    "patch:pages": "node scripts/patch-existing-pages.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.37.1",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "jsdom": "latest",
    "vitest": "latest",
    "wrangler": "^4.92.0",
    "sharp": "^0.34.5"
  }
}
