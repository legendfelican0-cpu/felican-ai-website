FROM node:22-alpine

ENV NODE_ENV=production \
    PORT=8080 \
    STATIC_ROOT=/app/public

WORKDIR /app
COPY --chown=node:node server/ /app/server/
COPY --chown=node:node dist/client/ /app/public/

USER node

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=4 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/api/ready || exit 1

CMD ["node", "/app/server/index.js"]
